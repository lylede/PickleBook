# Copy this file to .env and fill in your MySQL details
NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=picklebook

# Long random text (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Website address(es) allowed to call the API, comma separated
CLIENT_URL=http://localhost:4200

# Super admin account created by `npm run db:setup`
ADMIN_EMAIL=admin@picklebook.ph
ADMIN_PASSWORD=Admin@123
