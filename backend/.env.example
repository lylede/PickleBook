# Copy this file to .env and fill in your MySQL details
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=picklebook

# Change this to any long random text
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Angular dev server
CLIENT_URL=http://localhost:4200

# Super admin account created by `npm run db:setup`
ADMIN_EMAIL=admin@picklebook.ph
ADMIN_PASSWORD=Admin@123
